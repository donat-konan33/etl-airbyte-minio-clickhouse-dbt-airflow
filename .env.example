# Copy this file to .env and fill in the values for your environment.
# Never commit real secrets. Use strong random values in production.

# -----------------------------------------------------------------------------
# Public endpoints and local host ports
# -----------------------------------------------------------------------------
AIRFLOW_PORT=8080
API_PORT=8005
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000
POSTGRES_PORT=15432

# -----------------------------------------------------------------------------
# External data source
# -----------------------------------------------------------------------------
API_KEY=replace-with-your-api-key

# -----------------------------------------------------------------------------
# MinIO
# Internal Docker hostname for containers should usually remain the service name.
# -----------------------------------------------------------------------------
MINIO_USER_NAME=minioadmin
MINIO_USER_PASSWORD=change-me
AWS_ACCESS_KEY_ID=${MINIO_USER_NAME}
AWS_SECRET_ACCESS_KEY=${MINIO_USER_PASSWORD}
MINIO_HOST=minio
MINIO_HOST_IP=minio

# -----------------------------------------------------------------------------
# ClickHouse
# Use the service name inside Docker and published ports on the host.
# -----------------------------------------------------------------------------
CLICKHOUSE_DB=weather
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HOST=clickhouse-server
CLICKHOUSE_HOST_IP=clickhouse-server
CLICKHOUSE_HOSTNAME=clickhouse-server
CLICKHOUSE_DATABASE_URL=clickhouse+native://default:change-me@clickhouse-server:8123/weather

# -----------------------------------------------------------------------------
# PostgreSQL (Airflow metadata DB)
# -----------------------------------------------------------------------------
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_FIRST_NAME=Admin
AIRFLOW_ADMIN_LAST_NAME=User
AIRFLOW__CORE__FERNET_KEY=replace-with-a-valid-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW__WEBSERVER__WEB_SERVER_HOSTNAME=localhost

# Optional application metadata
LAKE_BUCKET=raw
LAKE_BUCKET_2=processed

# -----------------------------------------------------------------------------
# Legacy / optional values kept for compatibility with older scripts
# -----------------------------------------------------------------------------
AIRBYTE_ADMIN_USER=admin
AIRBYTE_ADMIN_PASSWORD=change-me
WORKSPACE_ID=replace-me
